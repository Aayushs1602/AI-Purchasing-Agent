# Copy to `.env` (same folder) and fill in values. `.env` is gitignored — never commit real keys.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Data ---
# SQLite file used by the API (default: backend/purchasing.db). Delete it or call the reset
# endpoint to restore every scenario to its starting state.
# DATABASE_URL=sqlite:///backend/purchasing.db
# Simulated "today": forecasts, ETAs and sales history are generated relative to this date.
SIM_TODAY=2026-10-01
# Allow POST /api/admin/reset to wipe and reseed the database. Set to false outside demos.
ALLOW_DEMO_RESET=true

# --- Debugging ---
# Read-only database browser at http://localhost:8000/admin. It has no login: keep it off
# anywhere but your own machine.
ADMIN_UI_ENABLED=true

# --- Custom scenarios ---
# Lets people build their own purchasing situation in the UI and run the agent on it
# (needs a live model: replay mode only has recordings of the demo scenarios).
ALLOW_CUSTOM_SCENARIOS=true
MAX_CUSTOM_SCENARIOS=20

# --- LLM (Google Gemini, free tier works) ---
# gemini = live model; replay = play back recordings from backend/recordings (no key needed).
LLM_PROVIDER=gemini
# Key: https://aistudio.google.com/apikey  (free-tier prompts may be used by Google to
# improve its products, so only mock data is ever sent).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
# Free tier allows roughly 15 requests/minute on Flash-Lite: keep calls spaced out.
LLM_MIN_INTERVAL_SECONDS=4
LLM_MAX_RETRIES=4
# Hard cap on model calls per agent run (a normal run needs 5-8).
AGENT_MAX_LLM_CALLS=16
# Agent runs the API executes at the same time (background workers).
AGENT_WORKERS=2
