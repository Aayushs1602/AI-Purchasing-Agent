# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Local data ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Node / frontend ---
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Evaluation scratch reports (CI and local runs; curated reports are committed) ---
backend/evals/reports/ci-*
backend/evals/reports/scratch-*
# Reports named after their mode (the README's commands without --name)
backend/evals/reports/scripted.*
backend/evals/reports/replay.*
backend/evals/reports/live.*
# Recordings of custom scenarios: their numbers restart after a reset, so they cannot replay.
backend/recordings/custom-*
